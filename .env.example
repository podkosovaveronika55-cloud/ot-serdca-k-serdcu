# Скопируйте в .env.local и заполните, чтобы включить общую базу (Supabase).
# Пока переменные не заданы, сайт честно работает в демо-режиме:
# игрушки хранятся в localStorage этого браузера.
#
# Project Settings → API → Project URL / anon public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Для GitHub Pages те же значения добавьте в
# Settings → Secrets and variables → Actions (repository secrets).
# Service role key во frontend не передавайте никогда.
